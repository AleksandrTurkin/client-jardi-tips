@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="layout-root">
    <MudLayout>
        <MudAppBar Elevation="0" Class="site-header">
            <MudContainer MaxWidth="MaxWidth.Large" Class="site-header__content">
                <MudButton Href="/"
                           Variant="Variant.Text"
                           Color="Color.Inherit"
                           StartIcon="@Icons.Material.Filled.Home"
                           Class="site-header__brand"
                           aria-label="JardiTips home">
                    JardiTips
                </MudButton>
                <MudSpacer />
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Inherit"
                           Class="site-header__sign-in">
                    Sign In
                </MudButton>
            </MudContainer>
        </MudAppBar>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="site-main">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
</div>
