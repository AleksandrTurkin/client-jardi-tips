@using System.Collections.Immutable
@using JardiTips.Client.Features.Categories.Models
@using JardiTips.Client.Shared.Components
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject JardiTips.Client.Application.Abstractions.IBrowserConnectivity Connectivity

<div class="category-carousel__wrapper @WrapperClass">
    <MudPaper Square="true" Elevation="3" Class="category-carousel__paper">
        <section class="category-carousel" aria-labelledby="@TitleId">
            <div class="category-carousel__header">
                <MudText Typo="Typo.h3" HtmlTag="@HeadingTag" id="@TitleId" Class="category-carousel__title">
                    @Title
                </MudText>
                @if (Categories.Length > 0 || ShowCreate)
                {
                    <div class="category-carousel__controls">
                        @if (ShowCreate && Connectivity.IsOnline)
                        {
                            <AuthorizeView>
                                <Authorized>
                                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                                   Color="Color.Primary"
                                                   Variant="Variant.Outlined"
                                                   aria-label="Create collection"
                                                   OnClick="OnCreate" />
                                </Authorized>
                            </AuthorizeView>
                        }
                        @if (Categories.Length > 0)
                        {
                            <MudIconButton Icon="@Icons.Material.Rounded.ChevronLeft"
                                           Color="Color.Primary"
                                           Variant="Variant.Outlined"
                                           aria-label="@($"Scroll {AriaLabel} left")"
                                           aria-controls="@ScrollerId"
                                           OnClick="@(() => ScrollAsync(-1))" />
                            <MudIconButton Icon="@Icons.Material.Rounded.ChevronRight"
                                           Color="Color.Primary"
                                           Variant="Variant.Outlined"
                                           aria-label="@($"Scroll {AriaLabel} right")"
                                           aria-controls="@ScrollerId"
                                           OnClick="@(() => ScrollAsync(1))" />
                        }
                    </div>
                }
            </div>
            <div id="@ScrollerId" class="category-carousel__scroller" aria-label="@AriaLabel" @ref="scroller">
                @foreach (var category in Categories)
                {
                    <div class="category-carousel__item" @key="category.Id">
                        <CategoryCard Category="category"
                                      ShowLike="ShowLike"
                                      CanLike="CanLike"
                                      IsLikeBusy="PendingLikeCategoryIds.Contains(category.Id)"
                                      OnLikeToggle="OnLikeToggle"
                                      ShowManage="@(ShowManage && Connectivity.IsOnline)"
                                      OnEdit="OnEdit"
                                      OnDelete="OnDelete"
                                      OnSelected="OnSelected" />
                    </div>
                }
            </div>
        </section>
    </MudPaper>
</div>

@code {
    private IJSObjectReference? module;
    private ElementReference scroller;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string AriaLabel { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string TitleId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ScrollerId { get; set; } = string.Empty;

    [Parameter]
    public string HeadingTag { get; set; } = "h2";

    [Parameter]
    public string? WrapperClass { get; set; }

    [Parameter]
    public ImmutableArray<CategoryDto> Categories { get; set; } = [];

    [Parameter]
    public ImmutableHashSet<Guid> PendingLikeCategoryIds { get; set; } = [];

    [Parameter]
    public bool ShowLike { get; set; } = true;

    [Parameter]
    public bool CanLike { get; set; }

    [Parameter]
    public bool ShowCreate { get; set; }

    [Parameter]
    public EventCallback OnCreate { get; set; }

    [Parameter]
    public EventCallback<CategoryDto> OnLikeToggle { get; set; }

    [Parameter]
    public EventCallback<CategoryDto> OnSelected { get; set; }

    [Parameter]
    public bool ShowManage { get; set; }

    [Parameter]
    public EventCallback<CategoryDto> OnEdit { get; set; }

    [Parameter]
    public EventCallback<CategoryDto> OnDelete { get; set; }

    protected override void OnInitialized() => Connectivity.ConnectivityChanged += OnConnectivityChanged;

    private void OnConnectivityChanged(bool isOnline) => _ = InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            module = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./Features/Categories/Components/CategoryCarousel.razor.js");
    }

    public async Task ScrollAsync(int direction)
    {
        if (module is not null)
            await module.InvokeVoidAsync("scrollCategories", scroller, direction);
    }

    public async ValueTask DisposeAsync()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        if (module is not null)
            await module.DisposeAsync();
    }
}
