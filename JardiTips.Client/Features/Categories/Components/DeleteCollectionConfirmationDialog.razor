<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body1">
            Delete "@Name" permanently?
            @if (TipsCount > 0)
            {
                <span>All @TipsCount tips in this collection will also be deleted.</span>
            }
            This action cannot be recovered.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm">Delete</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int TipsCount { get; set; }

    private void Cancel() => Dialog.Cancel();

    private void Confirm() => Dialog.Close(DialogResult.Ok(true));
}
