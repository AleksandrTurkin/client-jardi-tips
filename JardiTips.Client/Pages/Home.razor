@page "/"
@using JardiTips.Client.Application.Abstractions
@using JardiTips.Client.Features.Categories.Components
@using JardiTips.Client.Features.Home.Coordination
@using JardiTips.Client.Features.Home.Models
@using JardiTips.Client.Shared.Components
@implements IAsyncDisposable
@inject IHomeCoordinator HomeCoordinator
@inject IAuthenticationService AuthenticationService
@inject ISnackbar Snackbar

<PageTitle>Jardi Tips</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="home-collections">
            @if (State.UserCategoriesStatus == HomeLoadStatus.Loading)
            {
                <MudPaper Square="true" Elevation="3" Class="category-carousel__paper">
                    <section class="category-carousel" aria-labelledby="my-collections-title">
                        <div class="category-carousel__header">
                            <MudText Typo="Typo.h3" HtmlTag="h1" id="my-collections-title" Class="category-carousel__title">
                                My Collections
                            </MudText>
                        </div>
                        <div class="category-carousel__scroller" role="status" aria-label="Loading my collections">
                            @for (var index = 0; index < 3; index++)
                            {
                                <div class="category-carousel__item">
                                    <CategoryCardSkeleton />
                                </div>
                            }
                        </div>
                    </section>
                </MudPaper>
            }
            else if (State.UserCategoriesStatus == HomeLoadStatus.Failed)
            {
                <MudPaper Square="true" Elevation="3" Class="category-carousel__paper">
                    <section class="category-carousel" aria-labelledby="my-collections-title">
                        <div class="category-carousel__header">
                            <MudText Typo="Typo.h3" HtmlTag="h1" id="my-collections-title" Class="category-carousel__title">
                                My Collections
                            </MudText>
                        </div>
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
                            <MudText Typo="Typo.body1">Your collections could not be loaded.</MudText>
                            <MudButton Variant="Variant.Text" Color="Color.Warning" OnClick="ReloadUserCategoriesAsync" Class="mt-2">
                                Try again
                            </MudButton>
                        </MudAlert>
                    </section>
                </MudPaper>
            }
            else if (State.UserCategories.IsEmpty)
            {
                <MudPaper Square="true" Elevation="3" Class="category-carousel__paper">
                    <section class="category-carousel" aria-labelledby="my-collections-title">
                        <div class="category-carousel__header">
                            <MudText Typo="Typo.h3" HtmlTag="h1" id="my-collections-title" Class="category-carousel__title">
                                My Collections
                            </MudText>
                        </div>
                        <MudText Typo="Typo.body1" Color="Color.Secondary">
                            You do not have any collections yet.
                        </MudText>
                    </section>
                </MudPaper>
            }
            else
            {
                <CategoryCarousel Title="My Collections"
                                  HeadingTag="h1"
                                  AriaLabel="My collections"
                                  TitleId="my-collections-title"
                                  ScrollerId="my-collections-scroller"
                                  Categories="State.UserCategories"
                                  ShowLike="false"
                                  OnSelected="SelectCategory" />
            }
        </div>
    </Authorized>
</AuthorizeView>

@if (State.CategoriesStatus == HomeLoadStatus.Loading)
{
    <div role="status" aria-label="Loading categories">
        <CategoryCarouselSkeleton TitleWidth="240px" />
        <CategoryCarouselSkeleton TitleWidth="210px" Class="home-top-categories-skeleton" />
    </div>
}
else if (State.CategoriesStatus == HomeLoadStatus.Failed)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="home-alert">
        <MudText Typo="Typo.body1">Categories could not be loaded. Please try again.</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ReloadCategoriesAsync" Class="mt-2">
            Try again
        </MudButton>
    </MudAlert>
}
else if (State.Categories.IsEmpty)
{
    <MudPaper Outlined="true" Class="home-state home-state--empty">
        <MudIcon Icon="@Icons.Material.Outlined.Yard" Color="Color.Primary" Size="Size.Large" />
        <MudText Typo="Typo.h5">No categories yet</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">
            New gardening inspiration will appear here when it is available.
        </MudText>
    </MudPaper>
}
else
{
    <CategoryCarousel Title="New Releases"
                      HeadingTag="h1"
                      AriaLabel="New releases"
                      TitleId="new-releases-title"
                      ScrollerId="new-releases-scroller"
                      Categories="State.Categories"
                      PendingLikeCategoryIds="State.PendingLikeCategoryIds"
                      CanLike="AuthenticationService.IsAuthenticated"
                      OnLikeToggle="ToggleLikeAsync"
                      OnSelected="SelectCategory" />

    <CategoryCarousel Title="Top Courses"
                      AriaLabel="Top courses"
                      TitleId="top-courses-title"
                      ScrollerId="top-courses-scroller"
                      WrapperClass="home-top-categories"
                      Categories="State.TopCategories"
                      PendingLikeCategoryIds="State.PendingLikeCategoryIds"
                      CanLike="AuthenticationService.IsAuthenticated"
                      OnLikeToggle="ToggleLikeAsync"
                      OnSelected="SelectCategory" />
}

@if (State.SelectedCategory is not null)
{
    <TipsViewer @key="State.SelectedCategory.Id"
                 Category="State.SelectedCategory"
                 OnClose="CloseTips"
                 OnTipSaved="HandleTipSavedAsync" />
}
