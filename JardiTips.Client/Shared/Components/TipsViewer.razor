@using JardiTips.Client.Application.Abstractions
@using JardiTips.Client.Features.Categories.Models
@using JardiTips.Client.Features.Tips.Components
@using JardiTips.Client.Features.Tips.Coordination
@using JardiTips.Client.Features.Tips.Models
@implements IAsyncDisposable
@inject ITipQueries TipQueries
@inject IAuthenticationService AuthenticationService
@inject IBrowserConnectivity Connectivity
@inject TipManagementCoordinator TipManagement
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<TipsViewer> Logger

<MudOverlay Visible="true"
            DarkBackground="true"
            AutoClose="false"
            Style="z-index: 1200;"
            Class="tips-viewer-overlay">
    <div class="tips-viewer-host"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="tips-viewer-title"
         @ref="viewerContainer"
         @onkeydown="HandleKeyDownAsync">
        <MudPaper Square="true" Elevation="12" Class="tips-viewer-panel">
            <header class="tips-viewer-header">
                <MudText Typo="Typo.h5" HtmlTag="h2" id="tips-viewer-title" Class="tips-viewer-title">
                    @(currentTip?.Title ?? Category.Name)
                </MudText>
                <div class="tips-viewer-header__actions">
                    <div class="tips-viewer-navigation" aria-label="Tip navigation">
                        <MudIconButton Icon="@Icons.Material.Rounded.ChevronLeft"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Disabled="@(!CanMovePrevious)"
                                       OnClick="MovePreviousAsync"
                                       aria-label="Previous tip" />
                        <MudIconButton Icon="@Icons.Material.Rounded.ChevronRight"
                                       Color="Color.Primary"
                                       Variant="Variant.Outlined"
                                       Disabled="@(!CanMoveNext)"
                                       OnClick="MoveNextAsync"
                                       aria-label="Next tip" />
                    </div>
                    <MudIconButton Icon="@Icons.Material.Rounded.Close"
                                   Color="Color.Default"
                                   OnClick="CloseAsync"
                                   aria-label="Close tips" />
                </div>
            </header>

            <main class="tips-viewer-content"
                  aria-live="polite"
                  @ontouchstart="HandleTouchStart"
                  @ontouchend="HandleTouchEndAsync"
                  @ontouchcancel="ResetTouch">
                @if (isLoading)
                {
                    <div class="tips-viewer-skeleton" role="status" aria-label="Loading tips">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="48%" Height="36px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="100%" Height="24px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="92%" Height="24px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="96%" Height="24px" />
                        <MudSkeleton SkeletonType="SkeletonType.Text" Animation="Animation.Wave" Width="72%" Height="24px" />
                    </div>
                }
                else if (hasLoadError)
                {
                    <div class="tips-viewer-state">
                        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">
                            Tips could not be loaded. Cached tips remain available when possible.
                        </MudAlert>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RetryAsync">
                            Try again
                        </MudButton>
                    </div>
                }
                else if (currentTip is null)
                {
                    <div class="tips-viewer-state">
                        <MudIcon Icon="@Icons.Material.Outlined.TipsAndUpdates" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.h6">No tips are available in this category.</MudText>
                    </div>
                }
                else
                {
                    <MudCarousel TData="TipDto"
                                 Class="tips-viewer-carousel"
                                 SelectedIndex="@currentIndex"
                                 AutoCycle="false"
                                 ShowArrows="false"
                                 ShowBullets="false"
                                 EnableSwipeGesture="false">
                        @foreach (var tip in tips)
                        {
                            <MudCarouselItem @key="tip.Id" Transition="Transition.Slide">
                                <div class="tips-viewer-slide">
                                    <MarkdownContent Content="@tip.Content" />
                                </div>
                            </MudCarouselItem>
                        }
                    </MudCarousel>
                }
            </main>

            <footer class="tips-viewer-footer">
                @if (Category.Type == CategoryType.System && currentTip is not null)
                {
                    <TipSaveButton Tip="currentTip" OnSaved="OnTipSaved" />
                }

                @if (CanManage && AuthenticationService.IsAuthenticated)
                {
                    <div class="tips-viewer-management d-flex flex-wrap gap-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   Disabled="@(isDialogOpen || isDeleting || !Connectivity.IsOnline)" OnClick="CreateAsync">
                            Create tip
                        </MudButton>
                        @if (currentTip is not null)
                        {
                            <MudButton Variant="Variant.Text" Color="Color.Primary"
                                       Disabled="@(isDialogOpen || isDeleting || !Connectivity.IsOnline)" OnClick="EditAsync">
                                Edit
                            </MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Error"
                                       Disabled="@(isDialogOpen || isDeleting || !Connectivity.IsOnline)" OnClick="DeleteAsync">
                                @(isDeleting ? "Deleting…" : "Delete")
                            </MudButton>
                        }
                    </div>
                    @if (!Connectivity.IsOnline)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">
                            Managing tips requires an internet connection.
                        </MudText>
                    }
                }

                <MudText Typo="Typo.h6" Class="tips-viewer-count ms-auto">
                    @CurrentPosition of @TotalTipsCount
                </MudText>
            </footer>
        </MudPaper>
    </div>
</MudOverlay>

@code {
    private const double SwipeThreshold = 50;
    private CancellationTokenSource loadTokenSource = new();
    private ElementReference viewerContainer;
    private IReadOnlyList<TipDto> tips = [];
    private double? touchStartX;
    private double? touchStartY;
    private Guid loadedCategoryId;
    private int currentIndex;
    private bool hasMore;
    private bool isLoading;
    private bool isLoadingPage;
    private bool hasLoadError;
    private bool shouldFocus = true;
    private bool renderRequested = true;
    private bool isDialogOpen;
    private bool isDeleting;
    private int? tipCountOverride;
    private CategoryDto? countCategory;
    private CategoryDto? renderedCategory;

    [Parameter, EditorRequired]
    public CategoryDto Category { get; set; } = default!;

    [Parameter]
    public bool CanManage { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public EventCallback OnTipSaved { get; set; }

    [Parameter]
    public EventCallback OnTipsChanged { get; set; }

    private TipDto? currentTip => currentIndex >= 0 && currentIndex < tips.Count
        ? tips[currentIndex]
        : null;

    private bool CanMovePrevious => !isLoading && !isDialogOpen && !isDeleting && currentIndex > 0;

    private bool CanMoveNext => !isLoading
        && !isDialogOpen
        && !isDeleting
        && currentIndex + 1 < TotalTipsCount
        && (currentIndex + 1 < tips.Count || hasMore);

    private int CurrentPosition => currentTip is null ? 0 : currentIndex + 1;

    private int TotalTipsCount => tipCountOverride ?? Category.TipsCount;

    protected override void OnInitialized() => Connectivity.ConnectivityChanged += OnConnectivityChanged;

    protected override async Task OnParametersSetAsync()
    {
        if (countCategory is not null && (Category.Id != countCategory.Id || Category.TipsCount != countCategory.TipsCount))
            tipCountOverride = null;
        countCategory = Category;

        if (Category.Id == loadedCategoryId)
            return;

        renderRequested = true;
        await loadTokenSource.CancelAsync();
        loadTokenSource.Dispose();
        loadTokenSource = new CancellationTokenSource();
        loadedCategoryId = Category.Id;
        currentIndex = 0;
        tips = [];
        hasMore = false;
        hasLoadError = false;
        isLoading = true;

        try
        {
            await RefreshCollectionAsync(-1, loadTokenSource.Token);
        }
        catch (OperationCanceledException) when (loadTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to load tips for category {CategoryId}.", Category.Id);
            hasLoadError = true;
        }
        finally
        {
            isLoading = false;
            renderRequested = true;
        }
    }

    protected override bool ShouldRender() =>
        renderRequested || renderedCategory != Category;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        renderRequested = false;
        renderedCategory = Category;

        if (!shouldFocus)
            return;

        shouldFocus = false;
        await viewerContainer.FocusAsync();
    }

    private Task MovePreviousAsync()
    {
        if (CanMovePrevious)
        {
            renderRequested = true;
            currentIndex--;
        }

        return Task.CompletedTask;
    }

    private async Task MoveNextAsync()
    {
        if (!CanMoveNext)
            return;

        if (currentIndex + 1 >= tips.Count)
            await RefreshCollectionAsync(currentIndex, loadTokenSource.Token);

        if (currentIndex + 1 >= tips.Count)
            return;

        renderRequested = true;
        currentIndex++;
        StateHasChanged();
        await RefreshCollectionAsync(currentIndex, loadTokenSource.Token);
    }

    private async Task RetryAsync()
    {
        renderRequested = true;
        hasLoadError = false;
        isLoading = true;

        try
        {
            await RefreshCollectionAsync(-1, loadTokenSource.Token);
        }
        catch (OperationCanceledException) when (loadTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Failed to retry tips for category {CategoryId}.", Category.Id);
            hasLoadError = true;
        }
        finally
        {
            isLoading = false;
            renderRequested = true;
        }
    }

    private async Task RefreshCollectionAsync(int lastVisibleIndex, CancellationToken cancellationToken)
    {
        if (isLoadingPage)
            return;

        isLoadingPage = true;
        try
        {
            var collection = await TipQueries.GetAsync(Category.Id, lastVisibleIndex, cancellationToken);
            tips = collection.Tips;
            hasMore = collection.HasMore;
            renderRequested = true;
        }
        finally
        {
            isLoadingPage = false;
        }
    }

    private Task CreateAsync() => OpenEditorAsync(null);

    private Task EditAsync() => OpenEditorAsync(currentTip);

    private async Task OpenEditorAsync(TipDto? tip)
    {
        if (!CanManage || !AuthenticationService.IsAuthenticated || isDialogOpen || isDeleting)
            return;

        isDialogOpen = true;
        renderRequested = true;
        var categoryId = Category.Id;
        try
        {
            var parameters = new DialogParameters
            {
                [nameof(TipEditorDialog.Category)] = Category,
                [nameof(TipEditorDialog.Tip)] = tip
            };
            var options = new DialogOptions
            {
                FullWidth = true,
                MaxWidth = MaxWidth.Medium,
                CloseOnEscapeKey = false,
                BackdropClick = false
            };
            var dialog = await DialogService.ShowAsync<TipEditorDialog>(tip is null ? "Create tip" : "Edit tip", parameters, options);
            var result = await dialog.Result;

            if (result is null || result.Canceled || result.Data is not TipManagementResult mutation
                || loadTokenSource.IsCancellationRequested || Category.Id != categoryId)
                return;

            await RefreshAfterMutationAsync(0, mutation, tip is null ? "Tip created." : "Tip updated.", tip is null ? 1 : 0);
        }
        finally
        {
            isDialogOpen = false;
            renderRequested = true;
        }
    }

    private async Task DeleteAsync()
    {
        var tip = currentTip;
        if (tip is null || !CanManage || !AuthenticationService.IsAuthenticated || isDialogOpen || isDeleting)
            return;

        isDialogOpen = true;
        renderRequested = true;
        var categoryId = Category.Id;
        try
        {
            var dialog = await DialogService.ShowAsync<DeleteTipConfirmationDialog>(
                "Delete tip",
                new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.ExtraSmall, CloseOnEscapeKey = true });
            var confirmation = await dialog.Result;
            if (confirmation is null || confirmation.Canceled || confirmation.Data is not true
                || loadTokenSource.IsCancellationRequested || Category.Id != categoryId)
                return;

            isDeleting = true;
            renderRequested = true;
            StateHasChanged();
            var mutation = await TipManagement.DeleteAsync(tip, loadTokenSource.Token);
            if (loadTokenSource.IsCancellationRequested || Category.Id != categoryId)
                return;

            if (mutation.Status == TipManagementStatus.Succeeded)
                await RefreshAfterMutationAsync(currentIndex, mutation, "Tip deleted.", -1);
            else if (mutation.Status != TipManagementStatus.Cancelled)
                Snackbar.Add(MutationError(mutation), Severity.Error);
        }
        finally
        {
            isDeleting = false;
            isDialogOpen = false;
            renderRequested = true;
        }
    }

    private async Task RefreshAfterMutationAsync(int index, TipManagementResult mutation, string successMessage, int countChange)
    {
        var expectedCount = Math.Max(0, TotalTipsCount + countChange);
        try
        {
            tipCountOverride = expectedCount;
            await OnTipsChanged.InvokeAsync();
            if (!mutation.Refreshed)
                await TipQueries.InvalidateAsync(Category.Id, loadTokenSource.Token);

            tips = [];
            hasMore = false;
            currentIndex = 0;
            isLoading = true;
            renderRequested = true;
            StateHasChanged();

            do
            {
                var previousCount = tips.Count;
                await RefreshCollectionAsync(index, loadTokenSource.Token);
                if (tips.Count == previousCount)
                    break;
            }
            while (hasMore && tips.Count <= index);

            currentIndex = tips.Count == 0 ? 0 : Math.Min(index, tips.Count - 1);
            hasLoadError = false;
            Snackbar.Add(mutation.Refreshed ? successMessage : $"{successMessage} The collection summary may be out of date.",
                mutation.Refreshed ? Severity.Success : Severity.Warning);
        }
        catch (OperationCanceledException) when (loadTokenSource.IsCancellationRequested)
        {
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Tip mutation succeeded but category {CategoryId} could not be reloaded.", Category.Id);
            hasLoadError = true;
            Snackbar.Add("The tip was changed, but the collection could not be refreshed. Try reloading it.", Severity.Warning);
        }
        finally
        {
            isLoading = false;
            renderRequested = true;
        }
    }

    private static string MutationError(TipManagementResult result) => result.Status switch
    {
        TipManagementStatus.Unauthorized => "Please sign in again to manage tips.",
        TipManagementStatus.Offline => "Managing tips requires an internet connection.",
        TipManagementStatus.NotFound => "This tip is no longer available.",
        TipManagementStatus.Invalid => result.Message ?? "Please check the tip content.",
        _ => "The tip could not be deleted. Please try again."
    };

    private void OnConnectivityChanged(bool isOnline) => _ = InvokeAsync(() =>
    {
        renderRequested = true;
        StateHasChanged();
    });

    private Task CloseAsync() => isDialogOpen || isDeleting ? Task.CompletedTask : OnClose.InvokeAsync();

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        !isDialogOpen && !isDeleting && string.Equals(args.Key, "Escape", StringComparison.Ordinal)
            ? CloseAsync()
            : Task.CompletedTask;

    private void HandleTouchStart(TouchEventArgs args)
    {
        if (args.Touches.Length != 1)
        {
            ResetTouch();
            return;
        }

        touchStartX = args.Touches[0].ClientX;
        touchStartY = args.Touches[0].ClientY;
    }

    private async Task HandleTouchEndAsync(TouchEventArgs args)
    {
        var startX = touchStartX;
        var startY = touchStartY;
        ResetTouch();

        if (startX is null || startY is null || args.ChangedTouches.Length != 1)
            return;

        var horizontalDistance = args.ChangedTouches[0].ClientX - startX.Value;
        var verticalDistance = args.ChangedTouches[0].ClientY - startY.Value;

        if (Math.Abs(horizontalDistance) < SwipeThreshold
            || Math.Abs(horizontalDistance) <= Math.Abs(verticalDistance))
            return;

        if (horizontalDistance > 0)
            await MovePreviousAsync();
        else
            await MoveNextAsync();
    }

    private void ResetTouch()
    {
        touchStartX = null;
        touchStartY = null;
    }

    public async ValueTask DisposeAsync()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
        await loadTokenSource.CancelAsync();
        loadTokenSource.Dispose();
    }
}
